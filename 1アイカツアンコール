<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>アイカツ！アンコール 排出配列メモ</title>
  <style>
    :root {
      --bg-color: #f5f6f8;
      --card-bg: #ffffff;
      --text-color: #333333;
      --text-sub: #666666;
      --primary: #ff4081;
      --primary-hover: #f50057;
      --border-color: #e0e0e0;
      --input-bg: #ffffff;
      --accent-bg: #fff0f5;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    [data-theme="dark"] {
      --bg-color: #121212;
      --card-bg: #1e1e1e;
      --text-color: #e0e0e0;
      --text-sub: #aaaaaa;
      --primary: #ff4081;
      --primary-hover: #ff80ab;
      --border-color: #333333;
      --input-bg: #2c2c2c;
      --accent-bg: #2a1b24;
      --shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    body { background-color: var(--bg-color); color: var(--text-color); padding-bottom: 70px; }

    header {
      background-color: var(--card-bg);
      border-bottom: 1px solid var(--border-color);
      padding: 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 { font-size: 15px; color: var(--primary); }
    .header-actions { display: flex; gap: 6px; align-items: center; }

    .theme-toggle, .share-btn {
      background: none; border: 1px solid var(--border-color);
      color: var(--text-color); padding: 4px 8px; border-radius: 12px; font-size: 11px; cursor: pointer;
    }
    .share-btn { background-color: var(--accent-bg); border-color: var(--primary); color: var(--primary); font-weight: bold; }

    nav {
      display: flex; background: var(--card-bg); border-bottom: 1px solid var(--border-color);
    }

    .tab-btn {
      flex: 1; padding: 12px; text-align: center; background: none; border: none;
      color: var(--text-sub); font-weight: bold; font-size: 14px; cursor: pointer; border-bottom: 3px solid transparent;
    }

    .tab-btn.active { color: var(--primary); border-bottom-color: var(--primary); }

    .container { padding: 16px; max-width: 600px; margin: 0 auto; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }

    .btn {
      background-color: var(--primary); color: white; border: none; padding: 8px 16px;
      border-radius: 8px; font-weight: bold; cursor: pointer; font-size: 14px; display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    }
    .btn-secondary { background-color: #757575; }
    .btn-danger { background-color: #f44336; }
    .btn-sm { padding: 4px 8px; font-size: 12px; border-radius: 4px; }
    .btn-block { width: 100%; }

    .card-item, .sequence-item {
      background-color: var(--card-bg); border-radius: 8px; padding: 12px; margin-bottom: 12px;
      box-shadow: var(--shadow); border: 1px solid var(--border-color);
    }

    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
    .card-thumb {
      width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 6px; background-color: var(--border-color);
    }

    input, textarea, select {
      width: 100%; padding: 8px 12px; margin-top: 4px; margin-bottom: 12px;
      border: 1px solid var(--border-color); border-radius: 6px; background-color: var(--input-bg); color: var(--text-color); font-size: 14px;
    }

    .search-box { position: relative; margin-bottom: 16px; }

    .modal {
      display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background-color: rgba(0,0,0,0.5); z-index: 100; justify-content: center; align-items: center; padding: 16px;
    }
    .modal-content {
      background-color: var(--card-bg); width: 100%; max-width: 500px; border-radius: 12px;
      padding: 20px; max-height: 90vh; overflow-y: auto; box-shadow: var(--shadow);
    }

    .seq-card-list { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
    .seq-card-row {
      display: flex; align-items: center; gap: 8px; background: var(--accent-bg); padding: 6px 10px; border-radius: 6px;
    }

    .badge {
      background-color: var(--primary); color: white; font-size: 11px; padding: 2px 6px; border-radius: 4px;
    }
    .toast {
      position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%);
      background: rgba(0,0,0,0.8); color: white; padding: 10px 20px; border-radius: 20px;
      font-size: 13px; z-index: 1000; display: none;
    }
  </style>
</head>
<body>

  <header>
    <h1>アイカツ！アンコール 排出配列メモ</h1>
    <div class="header-actions">
      <button class="share-btn" onclick="shareDataUrl()">🔗 共有URLコピー</button>
      <button class="theme-toggle" id="themeToggleBtn">ダークモード</button>
    </div>
  </header>

  <nav>
    <button class="tab-btn active" onclick="switchTab('sequence')">配列</button>
    <button class="tab-btn" onclick="switchTab('cards')">カード</button>
  </nav>

  <div class="container">
    <div id="sequenceTab" class="tab-content active">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <button class="btn" onclick="openSequenceModal()">＋ 配列を追加</button>
      </div>
      <div class="search-box">
        <input type="text" id="seqSearchInput" placeholder="店舗・筐体・カード名・番号で検索..." oninput="renderSequences()">
      </div>
      <div id="sequenceList"></div>
    </div>

    <div id="cardsTab" class="tab-content">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
        <button class="btn" onclick="openCardModal()">＋ カードを登録</button>
      </div>
      <div class="search-box">
        <input type="text" id="cardSearchInput" placeholder="カード名・番号で検索..." oninput="renderCards()">
      </div>
      <div id="cardList" class="card-grid"></div>
    </div>
  </div>

  <div id="toast" class="toast">共有用URLをコピーしました！</div>

  <div id="confirmModal" class="modal">
    <div class="modal-content">
      <h3 id="confirmTitle" style="margin-bottom: 12px;">確認</h3>
      <p id="confirmMessage" style="margin-bottom: 20px; color: var(--text-sub);"></p>
      <div style="display: flex; gap: 8px; justify-content: flex-end;">
        <button class="btn btn-secondary" onclick="closeConfirmModal()">キャンセル</button>
        <button class="btn btn-danger" id="confirmOkBtn">実行</button>
      </div>
    </div>
  </div>

  <div id="cardModal" class="modal">
    <div class="modal-content">
      <h3 id="cardModalTitle">カード登録</h3>
      <form id="cardForm" onsubmit="saveCard(event)">
        <input type="hidden" id="cardId">
        <label>写真</label>
        <input type="file" id="cardPhotoInput" accept="image/jpeg,image/png" onchange="handleImageUpload(event)">
        <div id="cardPhotoPreview" style="margin-bottom:12px;"></div>
        <label>カード番号</label>
        <input type="text" id="cardNumberInput" required placeholder="例: PR-001">
        <label>カード名</label>
        <input type="text" id="cardNameInput" required placeholder="例: オーロラキスリボン">
        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 12px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('cardModal')">キャンセル</button>
          <button type="submit" class="btn">保存</button>
        </div>
      </form>
    </div>
  </div>

  <div id="cardDetailModal" class="modal">
    <div class="modal-content">
      <h3 id="detailCardName"></h3>
      <div id="detailCardInfo" style="margin: 12px 0;"></div>
      <h4 style="margin-top: 16px; margin-bottom: 8px; font-size: 14px;">排出履歴</h4>
      <div id="detailHistoryList" style="max-height: 200px; overflow-y: auto;"></div>
      <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px;">
        <button class="btn btn-secondary" onclick="closeModal('cardDetailModal')">閉じる</button>
      </div>
    </div>
  </div>

  <div id="sequenceModal" class="modal">
    <div class="modal-content">
      <h3 id="seqModalTitle">配列登録</h3>
      <form id="seqForm" onsubmit="saveSequence(event)">
        <input type="hidden" id="seqId">
        <label>店舗</label>
        <input type="text" id="seqShop" placeholder="例: ○○店">
        <label>筐体</label>
        <input type="text" id="seqMachine" placeholder="例: 筐体A">
        <label>日付</label>
        <input type="date" id="seqDate">
        <label>メモ</label>
        <textarea id="seqMemo" rows="2" placeholder="メモを入力..."></textarea>
        
        <hr style="margin: 16px 0; border: none; border-top: 1px solid var(--border-color);">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <h4 style="font-size: 14px;">並び（通り）の管理</h4>
          <button type="button" class="btn btn-sm" onclick="addPatternToSeqModal()">＋ 通りを追加</button>
        </div>
        <div id="seqPatternsContainer"></div>

        <div style="display: flex; gap: 8px; justify-content: flex-end; margin-top: 16px;">
          <button type="button" class="btn btn-secondary" onclick="closeModal('sequenceModal')">キャンセル</button>
          <button type="submit" class="btn">保存</button>
        </div>
      </form>
    </div>
  </div>

  <div id="selectCardModal" class="modal">
    <div class="modal-content">
      <h3>カードを選択</h3>
      <button class="btn btn-sm btn-block" style="margin: 8px 0;" onclick="openCardModalFromSelect()">＋ 未登録カードをその場で登録</button>
      <input type="text" id="selectCardSearch" placeholder="検索..." oninput="renderSelectCardList()">
      <div id="selectCardList" class="seq-card-list" style="max-height: 250px; overflow-y: auto;"></div>
      <div style="display: flex; justify-content: flex-end; margin-top: 12px;">
        <button class="btn btn-secondary" onclick="closeModal('selectCardModal')">閉じる</button>
      </div>
    </div>
  </div>
  <script>
    let db = { cards: [], sequences: [] };
    let assets = {};

    function initData() {
      const params = new URLSearchParams(window.location.search);
      const sharedData = params.get('data');
      if (sharedData) {
        try {
          const decoded = JSON.parse(decodeURIComponent(escape(atob(sharedData))));
          db = decoded.db || { cards: [], sequences: [] };
          assets = decoded.assets || {};
          saveData();
          window.history.replaceState({}, document.title, window.location.pathname);
        } catch(e) {
          console.error("データ読み込み失敗", e);
        }
      } else {
        db = JSON.parse(localStorage.getItem('aikatsu_db')) || { cards: [], sequences: [] };
        assets = JSON.parse(localStorage.getItem('aikatsu_assets')) || {};
      }
    }

    initData();

    let tempImageBase64 = null;
    let activePatternIndexForSelect = null;

    function saveData() {
      localStorage.setItem('aikatsu_db', JSON.stringify(db));
      localStorage.setItem('aikatsu_assets', JSON.stringify(assets));
    }

    function shareDataUrl() {
      const payload = { db, assets };
      const jsonStr = JSON.stringify(payload);
      const base64Str = btoa(unescape(encodeURIComponent(jsonStr)));
      const shareUrl = window.location.origin + window.location.pathname + '?data=' + encodeURIComponent(base64Str);

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(() => {
          showToast();
        });
      } else {
        prompt("以下のURLをコピーしてください", shareUrl);
      }
    }

    function showToast() {
      const t = id('toast');
      t.style.display = 'block';
      setTimeout(() => { t.style.display = 'none'; }, 2000);
    }

    const themeBtn = id('themeToggleBtn');
    themeBtn.addEventListener('click', () => {
      const isDark = document.body.getAttribute('data-theme') === 'dark';
      document.body.setAttribute('data-theme', isDark ? 'light' : 'dark');
      themeBtn.textContent = isDark ? 'ダークモード' : 'ライトモード';
    });

    function id(str) { return document.getElementById(str); }

    function normalizeText(str) {
      if (!str) return '';
      return str.normalize('NFKC')
        .toLowerCase()
        .replace(/[\u3041-\u3096]/g, m => String.fromCharCode(m.charCodeAt(0) + 0x60));
    }

    function switchTab(tab) {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      if (tab === 'sequence') {
        document.querySelectorAll('.tab-btn')[0].classList.add('active');
        id('sequenceTab').classList.add('active');
        renderSequences();
      } else {
        document.querySelectorAll('.tab-btn')[1].classList.add('active');
        id('cardsTab').classList.add('active');
        renderCards();
      }
    }

    function showConfirm(title, msg, onOk) {
      id('confirmTitle').textContent = title;
      id('confirmMessage').textContent = msg;
      id('confirmOkBtn').onclick = () => {
        onOk();
        closeConfirmModal();
      };
      id('confirmModal').style.display = 'flex';
    }

    function closeConfirmModal() { id('confirmModal').style.display = 'none'; }
    function closeModal(modalId) { id(modalId).style.display = 'none'; }

    function handleImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(evt) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          const maxDim = 900;
          if (width > height && width > maxDim) {
            height = Math.round((height * maxDim) / width); width = maxDim;
          } else if (height > maxDim) {
            width = Math.round((width * maxDim) / height); height = maxDim;
          }
          canvas.width = width; canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);
          tempImageBase64 = canvas.toDataURL('image/jpeg', 0.8);
          id('cardPhotoPreview').innerHTML = `<img src="${tempImageBase64}" style="max-height:100px; border-radius:6px; margin-top:8px;">`;
        };
        img.src = evt.target.result;
      };
      reader.readAsDataURL(file);
    }

    function openCardModal(card = null) {
      tempImageBase64 = null;
      id('cardForm').reset();
      id('cardPhotoPreview').innerHTML = '';
      if (card) {
        id('cardModalTitle').textContent = 'カード編集';
        id('cardId').value = card.id;
        id('cardNumberInput').value = card.number;
        id('cardNameInput').value = card.name;
        if (assets[card.id]) {
          id('cardPhotoPreview').innerHTML = `<img src="${assets[card.id]}" style="max-height:100px; border-radius:6px; margin-top:8px;">`;
        }
      } else {
        id('cardModalTitle').textContent = 'カード登録';
        id('cardId').value = '';
      }
      id('cardModal').style.display = 'flex';
    }

    function saveCard(e) {
      e.preventDefault();
      const cardId = id('cardId').value || 'card_' + Date.now();
      const number = id('cardNumberInput').value.trim();
      const name = id('cardNameInput').value.trim();

      if (tempImageBase64) {
        assets[cardId] = tempImageBase64;
      }

      const existingIndex = db.cards.findIndex(c => c.id === cardId);
      const cardData = { id: cardId, number, name };

      if (existingIndex >= 0) {
        db.cards[existingIndex] = cardData;
      } else {
        db.cards.push(cardData);
      }

      saveData();
      closeModal('cardModal');
      renderCards();
      if (activePatternIndexForSelect !== null) renderSelectCardList();
    }

    function deleteCard(cardId) {
      showConfirm('カード削除', 'このカードを削除しますか？', () => {
        db.cards = db.cards.filter(c => c.id !== cardId);
        delete assets[cardId];
        db.sequences.forEach(seq => {
          seq.patterns.forEach(pat => {
            pat.cardIds = pat.cardIds.filter(id => id !== cardId);
          });
        });
        saveData();
        renderCards();
      });
    }

    function renderCards() {
      const query = normalizeText(id('cardSearchInput').value);
      const list = id('cardList');
      list.innerHTML = '';

      const filtered = db.cards
    let tempPatterns = [];

    function openSequenceModal(seq = null) {
      id('seqForm').reset();
      if (seq) {
        id('seqModalTitle').textContent = '配列編集';
        id('seqId').value = seq.id;
        id('seqShop').value = seq.shop;
        id('seqMachine').value = seq.machine;
        id('seqDate').value = seq.date;
        id('seqMemo').value = seq.memo;
        tempPatterns = JSON.parse(JSON.stringify(seq.patterns));
      } else {
        id('seqModalTitle').textContent = '配列登録';
        id('seqId').value = '';
        id('seqDate').value = new Date().toISOString().split('T')[0];
        tempPatterns = [ { name: '1通り目', cardIds: [] } ];
      }
      renderTempPatterns();
      id('sequenceModal').style.display = 'flex';
    }

    function addPatternToSeqModal() {
      tempPatterns.push({ name: `${tempPatterns.length + 1}通り目`, cardIds: [] });
      renderTempPatterns();
    }

    function renderTempPatterns() {
      const container = id('seqPatternsContainer');
      container.innerHTML = '';
      tempPatterns.forEach((pat, pIdx) => {
        const pDiv = document.createElement('div');
        pDiv.style.background = 'var(--input-bg)';
        pDiv.style.border = '1px solid var(--border-color)';
        pDiv.style.borderRadius = '8px';
        pDiv.style.padding = '10px';
        pDiv.style.marginBottom = '12px';

        let cardsHtml = pat.cardIds.map((cId, cIdx) => {
          const card = db.cards.find(c => c.id === cId);
          const name = card ? `${card.number}${card.name}` : '不明なカード';
          return `
            <div class="seq-card-row">
              <span class="badge">${cIdx + 1}</span>
              <span style="flex:1; font-size:12px;" class="ellipsis">${name}</span>
              <button type="button" class="btn btn-sm btn-secondary" onclick="moveSeqCard(${pIdx},${cIdx}, -1)">↑</button>
              <button type="button" class="btn btn-sm btn-secondary" onclick="moveSeqCard(${pIdx},${cIdx}, 1)">↓</button>
              <button type="button" class="btn btn-sm btn-danger" onclick="removeSeqCard(${pIdx},${cIdx})">×</button>
            </div>
          `;
        }).join('');

        pDiv.innerHTML = `
          <div style="display:flex; gap:8px; align-items:center; margin-bottom:8px;">
            <input type="text" value="${pat.name}" onchange="tempPatterns[${pIdx}].name=this.value" style="margin:0; font-weight:bold;">
            <button type="button" class="btn btn-sm btn-danger" onclick="removePattern(${pIdx})">削除</button>
          </div>
          <div class="seq-card-list">${cardsHtml}</div>
          <button type="button" class="btn btn-sm" style="margin-top:8px;" onclick="openSelectCardModal(${pIdx})">＋ カードを追加</button>
        `;
        container.appendChild(pDiv);
      });
    }

    function removePattern(pIdx) {
      tempPatterns.splice(pIdx, 1);
      renderTempPatterns();
    }

    function moveSeqCard(pIdx, cIdx, dir) {
      const targetIdx = cIdx + dir;
      if (targetIdx < 0 || targetIdx >= tempPatterns[pIdx].cardIds.length) return;
      const arr = tempPatterns[pIdx].cardIds;
      const temp = arr[cIdx];
      arr[cIdx] = arr[targetIdx];
      arr[targetIdx] = temp;
      renderTempPatterns();
    }

    function removeSeqCard(pIdx, cIdx) {
      tempPatterns[pIdx].cardIds.splice(cIdx, 1);
      renderTempPatterns();
    }

    function openSelectCardModal(pIdx) {
      activePatternIndexForSelect = pIdx;
      id('selectCardSearch').value = '';
      renderSelectCardList();
      id('selectCardModal').style.display = 'flex';
    }

    function openCardModalFromSelect() {
      openCardModal();
    }

    function renderSelectCardList() {
      const query = normalizeText(id('selectCardSearch').value);
      const container = id('selectCardList');
      container.innerHTML = '';

      const filtered = db.cards.filter(c => 
        normalizeText(c.name).includes(query) || normalizeText(c.number).includes(query)
      );

      filtered.forEach(c => {
        const div = document.createElement('div');
        div.className = 'seq-card-row';
        div.style.cursor = 'pointer';
        div.onclick = () => {
          if (activePatternIndexForSelect !== null) {
            tempPatterns[activePatternIndexForSelect].cardIds.push(c.id);
            renderTempPatterns();
            closeModal('selectCardModal');
          }
        };
        div.innerHTML = `
          <div style="font-weight:bold; font-size:12px;">${c.number}</div>
          <div style="font-size:12px;" class="ellipsis">${c.name}</div>
        `;
        container.appendChild(div);
      });
    }

    function saveSequence(e) {
      e.preventDefault();
      const seqId = id('seqId').value || 'seq_' + Date.now();
      const shop = id('seqShop').value.trim();
      const machine = id('seqMachine').value.trim();
      const date = id('seqDate').value;
      const memo = id('seqMemo').value.trim();

      const seqData = { id: seqId, shop, machine, date, memo, patterns: tempPatterns };

      const existingIndex = db.sequences.findIndex(s => s.id === seqId);
      if (existingIndex >= 0) {
        db.sequences[existingIndex] = seqData;
      } else {
        db.sequences.push(seqData);
      }

      saveData();
      closeModal('sequenceModal');
      renderSequences();
    }

    function deleteSequence(seqId) {
      showConfirm('配列削除', 'この配列記録を削除しますか？', () => {
        db.sequences = db.sequences.filter(s => s.id !== seqId);
        saveData();
        renderSequences();
      });
    }

    function renderSequences() {
      const query = normalizeText(id('seqSearchInput').value);
      const list = id('sequenceList');
      list.innerHTML = '';

      const filtered = db.sequences.filter(seq => {
        if (normalizeText(seq.shop).includes(query) || normalizeText(seq.machine).includes(query)) return true;
        return seq.patterns.some(pat => 
          pat.cardIds.some(cId => {
            const card = db.cards.find(c => c.id === cId);
            return card && (normalizeText(card.name).includes(query) || normalizeText(card.number).includes(query));
          })
        );
      });

      filtered.forEach(seq => {
        const div = document.createElement('div');
        div.className = 'sequence-item';

        let patternsHtml = seq.patterns.map(pat => {
          let cardChips = pat.cardIds.map((cId, idx) => {
            const card = db.cards.find(c => c.id === cId);
            const num = card ? card.number : '?';
            const thumb = (card && assets[card.id]) ? assets[card.id] : '';
            return `
              <div style="flex: 0 0 60px; text-align: center; background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 6px; padding: 4px;">
                ${thumb ? `<img src="${thumb}" style="width: 45px; height: 60px; object-fit: cover; border-radius: 4px; display: block; margin: 0 auto 2px;">` : `<div style="width: 45px; height: 60px; background: var(--border-color); border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 9px; color: var(--text-sub); margin: 0 auto 2px;">NoImg</div>`}
                <div style="font-size: 10px; font-weight: bold; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${idx + 1}.</div>
                <div style="font-size: 10px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${num}</div>
              </div>
            `;
          }).join('');

          return `
            <div style="margin-top: 8px; background: var(--accent-bg); padding: 8px; border-radius: 6px;">
              <strong style="font-size: 12px; display: block; margin-bottom: 4px;">${pat.name}</strong>
              <div style="display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px;">
                ${cardChips || '<div style="font-size: 11px; color: var(--text-sub);">カードなし</div>'}
              </div>
            </div>
          `;
        }).join('');

        div.innerHTML = `
          <div style="display:flex; justify-content:space-between; align-items:flex-start;">
            <div>
              <strong style="font-size:15px;">${seq.shop || '店舗未設定'}</strong> 
              <span style="font-size:12px; color:var(--text-sub);">(${seq.machine || '筐体未設定'})</span>
              <div style="font-size:11px; color:var(--text-sub);">${seq.date}</div>
            </div>
            <div>
              <button class="btn btn-sm" onclick='openSequenceModal(${JSON.stringify(seq)})'>編集</button>
              <button class="btn btn-sm btn-danger" onclick="deleteSequence('${seq.id}')">削除</button>
            </div>
          </div>
          ${seq.memo ? `<div style="font-size:12px; margin-top:6px; color:var(--text-sub);">${seq.memo}</div>` : ''}
          ${patternsHtml}
        `;
        list.appendChild(div);
      });
    }

    renderSequences();
  </script>
</body>
</html>
